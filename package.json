{
  "name": "uni-market-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo del cliente de Uni Market: web (React) y móvil (Expo) sobre el contrato de uni-market-api",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens:build": "node packages/design-tokens/build.mjs",
    "contract:sync": "node scripts/contract-sync.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "api:generate": "node scripts/api-generate.mjs",
    "api:check": "node scripts/api-check.mjs",
    "dev:web": "pnpm --filter @uni-market/web dev",
    "build:web": "pnpm --filter @uni-market/web build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "dev:mobile": "pnpm --filter @uni-market/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@uni-market/config": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
