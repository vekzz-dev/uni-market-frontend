{
  "expo": {
    "name": "Uni Market",
    "slug": "uni-market",
    "scheme": "unimarket",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false },
    "web": { "bundler": "metro", "output": "static" }
  }
}
